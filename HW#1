raw_numbers = [
    "067\t123 4567",
    "(095) 234-5678\n",
    "+380 44 123 4567",
    "380501234567",
    "    +38(050)123-32-34",
    "     0503451234",
    "(050)8889900",
    "38050-111-22-22",
    "38050 111 22 11   ",
]


def normalize_phone_list(raw_numbers):
   cleaned_list = []
   for phone in raw_numbers:
    cleaned_numbers = re.sub(r'[^0-9]', '', phone)

    if cleaned_numbers.startswith('380'):
        cleaned_numbers = '+' + cleaned_numbers
    else:
        cleaned_numbers = '+38' + cleaned_numbers 
    cleaned_list.append(cleaned_numbers)
   return cleaned_list
   
result = normalize_phone_list(raw_numbers)
print("Cleaned numbers are:", result)
 